<Window x:Class="PhoneMonitor.Server.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="PhoneMonitor Server - USB Second Display" 
        Height="720" Width="960"
        MinHeight="600" MinWidth="800"
        Background="#0F1117"
        Foreground="#ECEFF4"
        FontFamily="Segoe UI, Segoe UI Variable Display"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <SolidColorBrush x:Key="CardBackground" Color="#1A1D27"/>
        <SolidColorBrush x:Key="CardBorder" Color="#2E3446"/>
        <SolidColorBrush x:Key="AccentColor" Color="#4F46E5"/>
        <SolidColorBrush x:Key="AccentHover" Color="#6366F1"/>
        <SolidColorBrush x:Key="SuccessColor" Color="#10B981"/>
        <SolidColorBrush x:Key="WarningColor" Color="#F59E0B"/>
        <SolidColorBrush x:Key="TextMuted" Color="#94A3B8"/>

        <Style TargetType="Border" x:Key="CardStyle">
            <Setter Property="Background" Value="{StaticResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button" x:Key="SecondaryButton">
            <Setter Property="Background" Value="#2A2E3D"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="180"/>
        </Grid.RowDefinitions>

        <!-- Top Header Bar -->
        <Border Grid.Row="0" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📱 PhoneMonitor" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <Border Margin="14,0,0,0" CornerRadius="12" Padding="10,3" Background="#1E293B" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtStatusBadge" Text="READY" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SuccessColor}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="USB High-Performance Second Monitor &amp; Native Touch Digitizer for Windows" 
                               FontSize="13" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Action Button Group -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnToggleServer" Content="▶ Start Streaming" Padding="20,10" FontSize="14" Click="BtnToggleServer_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area: 2 Columns -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="0.9*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Column: Display & Stream Setup -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,10,0">
                <StackPanel>
                    <!-- Display Card -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="🖥️ Target Monitor Selection" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                            
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="ComboMonitors" Height="36" Background="#232734" Foreground="#FFFFFF" 
                                          SelectionChanged="ComboMonitors_SelectionChanged"/>
                                <Button Grid.Column="1" Content="🔄 Refresh" Style="{StaticResource SecondaryButton}" 
                                        Margin="8,0,0,0" Click="BtnRefreshDisplays_Click"/>
                            </Grid>

                            <TextBlock x:Name="TxtDisplayDetails" Text="Bounds: 0,0 1920x1080 | Type: Primary" 
                                       FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,0,0,12"/>

                            <!-- Virtual Display & Extend Display Actions -->
                            <Border Background="#131722" CornerRadius="6" Padding="14" BorderBrush="#262C3D" BorderThickness="1">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Virtual Secondary Monitor (IddCx)" FontWeight="SemiBold" FontSize="13"/>
                                            <TextBlock Text="Installs a native secondary display device for Windows" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" x:Name="BtnInstallDriver" Content="⚡ Install / Enable Display" 
                                                Padding="12,6" Style="{StaticResource SecondaryButton}" Click="BtnSetupVirtualDisplay_Click"/>
                                    </Grid>

                                    <Separator Background="#262C3D" Margin="0,4,0,10"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="🔀 Extend Desktop (Win+P)" 
                                                Margin="0,0,6,0" Padding="10,8" Click="BtnExtendDesktop_Click"/>
                                        <Button Grid.Column="1" Content="⚙ Display Settings" Style="{StaticResource SecondaryButton}" 
                                                Margin="6,0,0,0" Padding="10,8" Click="BtnOpenDisplaySettings_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Stream Performance Tuning -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="⚡ Video &amp; Performance" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="Target Framerate:" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="ComboFps" SelectedIndex="1" SelectionChanged="ComboFps_SelectionChanged">
                                        <ComboBoxItem Content="30 FPS (Low Power)"/>
                                        <ComboBoxItem Content="60 FPS (Smooth)"/>
                                        <ComboBoxItem Content="90 FPS (High Refresh)"/>
                                        <ComboBoxItem Content="120 FPS (Ultra Smooth)"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="Bitrate (Quality):" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="ComboBitrate" SelectedIndex="2">
                                        <ComboBoxItem Content="8 Mbps (Low)"/>
                                        <ComboBoxItem Content="15 Mbps (Balanced)"/>
                                        <ComboBoxItem Content="25 Mbps (High Quality)"/>
                                        <ComboBoxItem Content="40 Mbps (Lossless Sharp)"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Right Column: USB & Touch Screen -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="10,0,0,0">
                <StackPanel>
                    <!-- USB & ADB Card -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="🔌 USB Connection (ADB)" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                            
                            <TextBlock Text="Connected Devices via USB:" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,0,0,4"/>
                            <ComboBox x:Name="ComboDevices" Height="36" Background="#232734" Foreground="#FFFFFF" Margin="0,0,0,10"/>

                            <Button x:Name="BtnAutoSetupUsb" Content="⚡ Setup USB Tunnel (ADB Reverse)" 
                                    Margin="0,0,0,10" Click="BtnAutoSetupUsb_Click"/>

                            <TextBlock x:Name="TxtAdbStatus" Text="ADB: Checking..." FontSize="12" Foreground="{StaticResource TextMuted}"/>
                        </StackPanel>
                    </Border>

                    <!-- Touch Screen Card -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="👆 Multi-Touch Digitizer" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                            
                            <TextBlock Text="Direct Windows Touch Injection (InitializeTouchInjection API)" 
                                       FontSize="12" Foreground="{StaticResource SuccessColor}" Margin="0,0,0,10"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <CheckBox x:Name="ChkInvertX" Content="Invert X Axis" Foreground="#E2E8F0" Margin="0,0,16,0" Checked="TouchConfig_Changed" Unchecked="TouchConfig_Changed"/>
                                <CheckBox x:Name="ChkInvertY" Content="Invert Y Axis" Foreground="#E2E8F0" Checked="TouchConfig_Changed" Unchecked="TouchConfig_Changed"/>
                            </StackPanel>

                            <TextBlock x:Name="TxtTouchStats" Text="Injected Touch Events: 0" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                        </StackPanel>
                    </Border>

                    <!-- Metrics Quick Box -->
                    <Border Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="CURRENT FPS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock x:Name="TxtFpsMetric" Text="0 FPS" FontSize="22" FontWeight="Bold" Foreground="{StaticResource SuccessColor}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="THROUGHPUT" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock x:Name="TxtBitrateMetric" Text="0.0 Mbps" FontSize="22" FontWeight="Bold" Foreground="#38BDF8"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Bottom Log / Console Panel -->
        <Border Grid.Row="2" Background="#141720" BorderBrush="#252A38" BorderThickness="1" CornerRadius="8" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Activity &amp; Connection Log" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Margin="0,0,0,6"/>
                <TextBox Grid.Row="1" x:Name="TxtConsoleLog" Background="Transparent" Foreground="#94A3B8" 
                         BorderThickness="0" IsReadOnly="True" VerticalScrollBarVisibility="Auto" 
                         FontFamily="Consolas, Cascadia Code" FontSize="11" TextWrapping="Wrap"/>
            </Grid>
        </Border>
    </Grid>
</Window>
